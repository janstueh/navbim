<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navbim_util</name>
  <version>0.0.0</version>
  <description>navbim utilities - C++ and Python common utilities</description>
  <maintainer email="jan.stuehrenberg@tuhh.de">Jan Stührenberg</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>navbim_msgs</depend>
  <depend>rclcpp</depend>
  <depend>visualization_msgs</depend>
  <depend>libboost-dev</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-shapely</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
